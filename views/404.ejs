<%- include('partial/head') %>
<style>
  @keyframes float {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(2deg); }
    100% { transform: translateY(0px) rotate(0deg); }
  }
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
</style>
</head>
<body class="bg-gray-100">
  <%- include('partial/nav') %>
   
  <main class="min-h-screen pt-28 pb-12 flex items-center justify-center px-4 font-sans">
    <div class="w-full max-w-2xl bg-white shadow-2xl rounded-[3.5rem] overflow-hidden border border-gray-100 p-12 md:p-20 text-center animate-in fade-in zoom-in duration-700">
      
      <div class="relative inline-block mb-8">
        <h1 class="text-9xl md:text-[12rem] font-black text-red-500 opacity-10 absolute inset-0 -mt-4 animate-pulse">
          404
        </h1>
        <h1 class="text-8xl md:text-[10rem] font-black text-red-500 relative z-10 animate-float drop-shadow-2xl">
          404
        </h1>
      </div>

      <div class="space-y-4">
        <h2 class="text-4xl font-bold text-gray-800">Oops! Page Lost.</h2>
        <p class="text-gray-500 text-lg max-w-md mx-auto">
          We can't seem to find the place you're looking for. It might have moved or doesn't exist anymore.
        </p>
      </div>

      <div class="mt-12">
        <a href="/" 
          class="inline-block bg-red-500 text-white font-bold py-4 px-10 rounded-2xl shadow-xl shadow-red-200 hover:bg-red-700 hover:-translate-y-1 hover:shadow-2xl active:scale-95 transition-all duration-300 text-lg">
          Return to Home
        </a>
      </div>

      <div class="mt-12 flex justify-center space-x-2">
        <div class="w-3 h-3 bg-red-200 rounded-full"></div>
        <div class="w-3 h-3 bg-red-400 rounded-full"></div>
        <div class="w-3 h-3 bg-red-500 rounded-full"></div>
      </div>
    </div>
  </main>
  
</body>
</html>