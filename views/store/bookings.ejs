<%- include('../partial/head') %>
<style>
  /* Animation for the booking rows */
  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .booking-card {
    opacity: 0;
    animation: slideInRight 0.5s ease forwards;
  }
</style>
</head>
<body class="bg-gray-100">
  <%- include('../partial/nav') %>
   
  <main class="min-h-screen pt-28 pb-12 px-4 sm:px-8 font-sans">
    
    <div class="max-w-5xl mx-auto bg-white shadow-xl rounded-[2.5rem] p-10 mb-10 text-center border border-gray-100 animate-in fade-in zoom-in duration-700">
      <h1 class="text-5xl font-black text-red-500 italic tracking-tighter mb-2">My Bookings</h1>
      <p class="text-gray-500 text-lg">Manage your upcoming stays and travel history.</p>
    </div>

    <div class="max-w-5xl mx-auto space-y-6">
      
      <% const dummyBookings = [
        { name: 'Radhey House', price: '450', date: 'May 12, 2026', status: 'Confirmed', guests: 2, photo: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=800&q=80' },
        { name: 'Gangesh Home New', price: '320', date: 'June 05, 2026', status: 'Pending', guests: 4, photo: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80' }
      ] %>

      <% dummyBookings.forEach((booking, index) => { %>
        <div class="booking-card bg-white rounded-[2rem] shadow-lg border border-gray-100 overflow-hidden flex flex-col md:flex-row items-center p-4 transition-all duration-300 hover:shadow-2xl hover:-translate-y-1"
             style="animation-delay: <%= index * 150 %>ms">
          
          <div class="w-full md:w-48 h-32 rounded-2xl overflow-hidden mb-4 md:mb-0">
            <img src="<%= booking.photo %>" class="w-full h-full object-cover">
          </div>

          <div class="flex-1 md:ml-8 text-center md:text-left">
            <h2 class="text-2xl font-black text-gray-800"><%= booking.name %></h2>
            <div class="flex flex-wrap justify-center md:justify-start gap-4 mt-2">
              <p class="text-gray-500 font-medium">📅 <%= booking.date %></p>
              <p class="text-gray-500 font-medium">👥 <%= booking.guests %> Guests</p>
            </div>
          </div>

          <div class="md:text-right p-4 w-full md:w-auto border-t md:border-t-0 md:border-l border-gray-100 flex flex-row md:flex-col justify-between items-center md:items-end gap-2">
            <span class="text-2xl font-black text-red-500">$<%= booking.price %></span>
            <span class="px-4 py-1 rounded-full text-sm font-bold <%= booking.status === 'Confirmed' ? 'bg-green-100 text-green-600' : 'bg-yellow-100 text-yellow-600' %>">
              <%= booking.status %>
            </span>
          </div>

          <div class="md:ml-6">
            <a href="/" class="block bg-gray-900 text-white px-6 py-3 rounded-xl font-bold hover:bg-red-500 transition-all duration-300 shadow-md">
              Details
            </a>
          </div>
        </div>
      <% }) %>

    </div>

    <div class="mt-12 text-center">
      <a href="/" class="inline-block bg-red-500 text-white font-black py-4 px-10 rounded-2xl shadow-xl shadow-red-200 hover:bg-red-700 hover:-translate-y-1 active:scale-95 transition-all duration-300 text-lg">
        Return to Home
      </a>
    </div>
  </main>
  
</body>
</html>