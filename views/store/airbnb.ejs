<%-include('../partial/head') %>
<style>
  /* Staggered fade-in animation */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .home-card {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>
</head>
<body class="bg-gray-100">
  <%- include('../partial/nav') %>
  
  <main class="min-h-screen pt-28 pb-12 px-4 sm:px-8 font-sans">
    
    <div class="max-w-4xl mx-auto bg-white shadow-xl rounded-[2.5rem] p-10 mb-16 text-center border border-gray-100 animate-in fade-in slide-in-from-top-8 duration-1000">
      <h1 class="text-5xl md:text-6xl font-black text-red-500 italic tracking-tighter mb-3">
        Welcome to airbnb
      </h1>
      <p class="text-gray-500 text-xl font-medium">Find your next adventure in a click.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-10 max-w-7xl mx-auto">
      <% registorHome.forEach((home, index) => { %>
        <div class="home-card bg-white rounded-[3rem] shadow-lg overflow-hidden border border-gray-100 group transition-all duration-500 hover:shadow-2xl hover:-translate-y-3" 
             style="animation-delay: <%= index * 100 %>ms">
          
          <a href="/home-details/<%=home._id%>" class="block relative overflow-hidden h-64">
            <img src="<%= home.photo %>" alt="<%= home.homeName %>" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy">
            
            <div class="absolute top-5 right-5 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full shadow-md text-sm font-bold text-gray-800">
              <%= home.rating %> ⭐
            </div>
          </a>
          
          <div class="p-8">
            <h2 class="text-2xl font-black text-gray-900 mb-1 group-hover:text-red-500 transition-colors duration-300">
              <%= home.homeName %>
            </h2>
            
            <p class="text-gray-500 font-medium mb-6 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
              <%= home.location %>
            </p>
            
            <div class="flex items-center justify-between mt-auto">
              <div>
                <span class="text-3xl font-black text-red-500">$<%= home.price %></span>
                <span class="text-gray-400 text-xs font-bold uppercase tracking-widest">/ night</span>
              </div>

              <a href="/home-details/<%=home._id%>" 
                class="bg-red-500 text-white font-bold py-3 px-8 rounded-2xl shadow-lg shadow-red-100 hover:bg-red-700 hover:shadow-red-200 transform transition-all duration-300 active:scale-90">
                Book
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>