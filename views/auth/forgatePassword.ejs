<%- include("../partial/head") %>
</head>
<body class="bg-gray-100">
  <%- include("../partial/nav") %>

  <main class="min-h-screen pt-28 pb-12 flex items-center justify-center px-4 sm:px-6 lg:px-8 font-sans">
    
    <div class="flex flex-col md:flex-row w-full max-w-6xl bg-white shadow-2xl rounded-[3.5rem] overflow-hidden border border-gray-100 animate-in fade-in zoom-in duration-700">
      
      <div class="hidden md:flex md:w-5/12 bg-red-500 flex-col justify-between p-16 text-white relative">
        <div class="z-10">
          <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center text-2xl font-black mb-12">
            ?
          </div>
          <h1 class="text-5xl font-black italic leading-[1.15] tracking-tighter animate-in slide-in-from-left duration-700">
            A house is made <br>of walls and beams. <br>A home is built <br>with love... <br>and a password <br>you can actually <br>remember. 🏠🔑
          </h1>
        </div>

        <div class="z-10 text-sm font-bold opacity-60 uppercase tracking-widest">
          The Real Estate of Mind
        </div>

        <div class="absolute top-0 right-0 w-48 h-48 bg-red-400 rounded-bl-full opacity-40"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 bg-red-600 rounded-tr-full opacity-30"></div>
      </div>

      <div class="w-full md:w-7/12 flex items-center justify-center p-8 md:p-20 bg-white">
        <div class="w-full max-w-md space-y-10 animate-in fade-in slide-in-from-right duration-700">
          
          <header>
            <h2 class="text-5xl font-black text-gray-900 mb-3 tracking-tighter">Recover Account</h2>
            <p class="text-gray-400 text-lg font-medium">Enter your email to receive a reset link.</p>
          </header>

          <form method="post" action="/forgot-password" class="space-y-8">
            
            <div class="group">
              <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-3 ml-1">Email Address</label>
              <input type="email" name="email" placeholder="name@company.com" required
                class="w-full bg-neutral-50 border border-neutral-100 rounded-2xl px-6 py-5 text-neutral-900 focus:ring-4 focus:ring-red-500/10 focus:border-red-500 outline-none transition-all duration-300 placeholder:text-neutral-300 hover:-translate-y-1 hover:shadow-lg hover:bg-white">
            </div>

            <div class="pt-4">
              <button type="submit" 
                class="w-full bg-red-500 hover:bg-red-600 text-white font-black py-5 rounded-2xl shadow-2xl shadow-red-200 transform transition-all duration-300 hover:-translate-y-1 active:scale-95 text-xl tracking-tight">
                Send Reset Link
              </button>
            </div>

          </form>

          <footer class="text-center pt-6 border-t border-gray-50">
            <p class="text-gray-400 font-medium text-lg">
              Remembered it suddenly? 
              <a href="/login" class="text-gray-900 font-black hover:text-red-500 transition-colors ml-1 underline decoration-2 decoration-red-200 underline-offset-4">Log In</a>
            </p>
          </footer>

        </div>
      </div>

    </div>
  </main>

</body>
</html>