<%- include("../partial/head") %>
<style>
  /* Left to Right Entrance Animation */
  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(-60px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-text-slide {
    opacity: 0;
    animation: slideInRight 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  .delay-1 { animation-delay: 0.1s; }
  .delay-2 { animation-delay: 0.3s; }
  .delay-3 { animation-delay: 0.5s; }
</style>
</head>
<body class="bg-[#f8f9fa]">
  <%-include("../partial/nav")%>

  <main class="min-h-screen pt-28 pb-12 flex items-center justify-center px-4 sm:px-6 lg:px-8 font-sans">
    
    <div class="flex flex-col md:flex-row w-full max-w-6xl bg-white shadow-2xl rounded-[3.5rem] overflow-hidden border border-gray-100 animate-in fade-in zoom-in duration-700">
      
      <div class="hidden md:flex md:w-5/12 bg-red-500 p-16 flex-col justify-between text-white relative overflow-hidden">
        <div class="absolute top-0 right-0 w-80 h-80 bg-white rounded-full mix-blend-overlay filter blur-[100px] opacity-20 -mr-32 -mt-32"></div>
        <div class="z-10">
          <div class="w-12 h-12 bg-white rounded-2xl mb-12 flex items-center justify-center font-black text-2xl text-red-500 shadow-lg animate-text-slide delay-1">S.</div>
          <h1 class="text-5xl font-black italic leading-[1.15] tracking-tighter animate-text-slide delay-2">
            I promise <br />I won't ask <br />you to click <br />on all the <br />traffic lights. <br />I already <br />know you're <br />human. 🚦🤖
          </h1>
        </div>
        <div class="z-10 text-white/50 text-xs font-bold tracking-[0.2em] uppercase animate-text-slide delay-3">HUMAN VERIFIED EXPERIENCE</div>
        <div class="absolute top-0 right-0 w-48 h-48 bg-red-400 rounded-bl-full opacity-40"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 bg-red-600 rounded-tr-full opacity-30"></div>
      </div>

      <div class="w-full md:w-7/12 flex items-center justify-center p-8 md:p-14 bg-white">
        <div class="w-full max-w-xl animate-in fade-in slide-in-from-right duration-700">
          
          <div class="mb-12 text-left space-y-2">
            <h2 class="text-5xl font-black text-gray-900 tracking-tighter">Sign Up</h2>
            <p class="text-gray-400 text-lg font-medium">Create your credentials to begin exploring.</p>
          </div>

          <form method="post" action="/singup" class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="group">
                <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-3 ml-1">First Name</label>
                <input type="text" name="firstName" placeholder="Gangesh" required
                  class="w-full bg-neutral-50 border border-neutral-100 rounded-2xl px-6 py-5 text-neutral-900 focus:ring-4 focus:ring-red-500/10 focus:border-red-500 outline-none transition-all duration-300 placeholder:text-neutral-300 hover:-translate-y-1 hover:shadow-lg hover:bg-white">
              </div>
              <div class="group">
                <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-3 ml-1">Last Name</label>
                <input type="text" name="lastName" placeholder="Jha" required
                  class="w-full bg-neutral-50 border border-neutral-100 rounded-2xl px-6 py-5 text-neutral-900 focus:ring-4 focus:ring-red-500/10 focus:border-red-500 outline-none transition-all duration-300 placeholder:text-neutral-300 hover:-translate-y-1 hover:shadow-lg hover:bg-white">
              </div>
            </div>

            <div class="group">
              <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-3 ml-1">Email Address</label>
              <input type="email" name="email" placeholder="example@gmail.com" required
                class="w-full bg-neutral-50 border border-neutral-100 rounded-2xl px-6 py-5 text-neutral-900 focus:ring-4 focus:ring-red-500/10 focus:border-red-500 outline-none transition-all duration-300 placeholder:text-neutral-300 hover:-translate-y-1 hover:shadow-lg hover:bg-white">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="group">
                <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-3 ml-1">Password</label>
                <input type="password" name="password" placeholder="••••••••" required
                  class="w-full bg-neutral-50 border border-neutral-100 rounded-2xl px-6 py-5 text-neutral-900 focus:ring-4 focus:ring-red-500/10 focus:border-red-500 outline-none transition-all duration-300 placeholder:text-neutral-300 hover:-translate-y-1 hover:shadow-lg hover:bg-white">
              </div>
              <div class="group">
                <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-3 ml-1">Confirm</label>
                <input type="password" name="confirmPassword" placeholder="••••••••" required
                  class="w-full bg-neutral-50 border border-neutral-100 rounded-2xl px-6 py-5 text-neutral-900 focus:ring-4 focus:ring-red-500/10 focus:border-red-500 outline-none transition-all duration-300 placeholder:text-neutral-300 hover:-translate-y-1 hover:shadow-lg hover:bg-white">
              </div>
            </div>

            <div class="group pt-2">
              <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-4 ml-1">I am signing up as a:</label>
              <div class="flex gap-5">
                <label class="flex-1 cursor-pointer">
                  <input type="radio" name="userType" value="guest" class="hidden peer" checked>
                  <div class="py-4 text-center border border-neutral-100 rounded-2xl font-bold text-neutral-500 transition-all duration-300 peer-checked:bg-red-500 peer-checked:text-white peer-checked:border-red-500 peer-checked:shadow-lg hover:bg-red-50 hover:text-red-500 hover:-translate-y-1 hover:shadow-md">
                    Guest
                  </div>
                </label>
                <label class="flex-1 cursor-pointer">
                  <input type="radio" name="userType" value="host" class="hidden peer">
                  <div class="py-4 text-center border border-neutral-100 rounded-2xl font-bold text-neutral-500 transition-all duration-300 peer-checked:bg-red-500 peer-checked:text-white peer-checked:border-red-500 peer-checked:shadow-lg hover:bg-red-50 hover:text-red-500 hover:-translate-y-1 hover:shadow-md">
                    Host
                  </div>
                </label>
              </div>
            </div>

            <div class="flex items-center space-x-4 py-3 border border-neutral-100/50 bg-neutral-50/50 p-4 rounded-xl hover:shadow-sm transition-all duration-300">
              <input type="checkbox" name="terms" id="terms" required
                class="w-7 h-7 text-red-500 border-neutral-200 rounded-lg focus:ring-red-500 accent-red-500 cursor-pointer shadow-sm hover:scale-110 transition-transform">
              <label for="terms" class="text-sm font-medium text-gray-600 cursor-pointer select-none">
                I agree to the <a href="#" class="text-red-500 font-black hover:text-red-700 transition-colors underline decoration-red-100 underline-offset-4 decoration-2">Terms and Conditions</a>
              </label>
            </div>

            <button type="submit" 
              class="w-full bg-red-500 hover:bg-red-600 text-white font-black py-5 rounded-3xl shadow-2xl shadow-red-200 transform transition-all active:scale-[0.98] duration-300 text-xl tracking-wide hover:-translate-y-1">
              Create Account
            </button>
          </form>

          <footer class="mt-12 text-center pt-8 border-t border-neutral-100">
            <p class="text-neutral-400 font-medium text-lg">
                Already have an account? 
                <a href="/login" class="text-gray-900 font-black hover:text-red-500 transition-colors ml-1 underline decoration-red-100 underline-offset-8 decoration-2">Log In</a>
            </p>
          </footer>
        </div>
      </div>
    </div>
  </main>
</body>