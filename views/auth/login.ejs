<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Plus Jakarta Sans", sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#f8f9fa]">
    <%- include('../partial/nav') %>
    
    <div class="min-h-[calc(100vh-64px)] flex items-center justify-center p-6">
      <div
        class="flex flex-col md:flex-row w-full max-w-5xl bg-white rounded-[30px] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-neutral-100"
      >
        <div
          class="hidden md:flex md:w-1/2 bg-red-500 p-12 flex-col justify-between relative overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 w-64 h-64 bg-red-500 rounded-full mix-blend-screen filter blur-[80px] opacity-20 -mr-20 -mt-20"
          ></div>

          <div class="relative z-10">
            <div
              class="w-10 h-10 bg-white rounded-xl mb-8 flex items-center justify-center font-bold text-xl text-black"
            >
              S.
            </div>
            <h2 class="text-4xl font-extrabold text-white leading-tight">
              Design is the <br />silent ambassador <br />of your brand.
            </h2>
          </div>

          <div class="relative z-10 text-neutral-500 text-xs tracking-widest">
            © 2026 CHERRYYOB INC.
          </div>
        </div>

        <div class="w-full md:w-1/2 p-10 md:p-16 lg:p-20">
          <div class="max-w-sm mx-auto">
            <h3 class="text-3xl font-extrabold text-neutral-900 mb-2">
              Sign In
            </h3>
            <p class="text-neutral-500 mb-10 text-sm">
              Enter your details to access your workspace.
            </p>

            <form action="/login" method="post" class="space-y-6">
              <div>
                <label
                  for="emailId"
                  class="block text-[10px] font-bold uppercase tracking-widest text-neutral-400 mb-2 ml-1"
                  >Email Address</label
                >
                <input
                  type="email"
                  name="emailId"
                  id="emailId"
                  placeholder="name@company.com"
                  /* MATCHED RED FOCUS: focus:ring-red-500 */
                  class="w-full bg-neutral-50 border border-neutral-100 rounded-2xl px-5 py-4 text-neutral-900 focus:ring-2 focus:ring-red-500 outline-none transition-all placeholder:text-neutral-300"
                  required
                />
              </div>

              <div>
                <div class="flex justify-between items-center mb-2 ml-1">
                  <label
                    for="password"
                    class="block text-[10px] font-bold uppercase tracking-widest text-neutral-400"
                    >Password</label
                  >
                  <a
                    href="#"
                    class="text-[10px] font-bold text-red-500 uppercase tracking-tighter hover:text-red-600"
                    >Forgot?</a
                  >
                </div>
                <input
                  type="password"
                  name="password"
                  id="password"
                  placeholder="••••••••"
                  /* MATCHED RED FOCUS: focus:ring-red-500 */
                  class="w-full bg-neutral-50 border border-neutral-100 rounded-2xl px-5 py-4 text-neutral-900 focus:ring-2 focus:ring-red-500 outline-none transition-all placeholder:text-neutral-300"
                  required
                />
              </div>

              <button
                type="submit"
                class="w-full bg-red-500 hover:bg-red-700 text-white font-bold py-4 rounded-2xl shadow-xl transition-all duration-300 transform active:scale-95"
              >
                Continue
              </button>
            </form>

            <div
              class="mt-10 pt-8 border-t border-neutral-100 flex items-center justify-center"
            >
              <span class="text-neutral-400 text-sm">New here?</span>
              <a
                href="#"
                class="ml-2 text-sm font-bold text-neutral-900 hover:text-red-500 transition-colors"
                >Create an account</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>